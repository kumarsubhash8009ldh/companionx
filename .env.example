# ==========================================
# COMPANIONX: ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# IMPORTANT: Never commit production API keys, service accounts, or private secrets to frontend code.

# Platform Brand Configuration
VITE_APP_NAME="CompanionX"
VITE_SUPPORT_EMAIL="concierge@companionx.in"
VITE_COMPLIANCE_EMAIL="legal-safety@companionx.in"
VITE_EMERGENCY_DESK_NUMBER="+91 1800-267-2667"

# Firebase Client SDK Configuration (Frontend-safe public credentials)
VITE_FIREBASE_API_KEY="AIzaSyA_example_public_api_key"
VITE_FIREBASE_AUTH_DOMAIN="companionx-india.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="companionx-india"
VITE_FIREBASE_STORAGE_BUCKET="companionx-india.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Payment Gateway (Client Public Key Only - Never store Secret Key in Frontend)
# Indian Gateways: Razorpay / Cashfree Payments
VITE_RAZORPAY_KEY_ID="rzp_test_YourPublicKeyHere"
VITE_PAYMENT_CURRENCY="INR"

# Real-time Video Provider (Client App ID Only)
# Providers: Agora.io / Twilio Programmable Video / 100ms
VITE_AGORA_APP_ID="your_agora_app_id_here"

# Server / Backend API Endpoint
VITE_API_BASE_URL="https://asia-south1-companionx-india.cloudfunctions.net/api"

# Default Platform Commission (10% to 20%)
VITE_DEFAULT_COMMISSION_RATE="0.15"
